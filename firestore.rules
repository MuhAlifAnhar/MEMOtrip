rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: mendapatkan role user saat ini
    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return getUserRole(request.auth.uid) in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return getUserRole(request.auth.uid) == 'super_admin';
    }

    // ─── KOLEKSI YANG DILINDUNGI (RBAC) ───

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      // Hanya super_admin yang bisa mengubah role
      allow update: if isSuperAdmin();
    }

    match /destinations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /schedules/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read, write: if isAdmin();
    }

    match /iot_devices/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /memories/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    // ─── ATURAN DEFAULT (PENGEMBANGAN) ───
    // Semua koleksi lain yang belum didefinisikan di atas akan tetap terbuka 
    // seperti aturan Anda sebelumnya (allow read, write: if true).
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
